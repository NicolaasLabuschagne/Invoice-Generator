generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id              String        @id
  email           String        @unique
  logoUrl         String?       @map("logo_url")
  themeColor      String?       @default("#2563eb") @map("theme_color")
  companyName     String?       @map("company_name")
  companyAddress  String?       @map("company_address")
  companyEmail    String?       @map("company_email")
  companyPhone    String?       @map("company_phone")
  invoiceTemplate String?       @map("invoice_template")
  quoteTemplate   String?       @map("quote_template")
  bankInfo        String?       @map("bank_info")
  licenceInfo     String?       @map("licence_info")
  currency        String?       @default("$")
  medicHourlyRate Float?          @default(150) @map("medic_hourly_rate")
  roundToNearest  Boolean         @default(false) @map("round_to_nearest")
  clients         Client[]
  invoices        Invoice[]
  jobs            Job[]
  quotes          Quote[]
  service_rates   ServiceRate[]

  @@map("profiles")
}

model Client {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  name          String
  contactPerson String    @map("contact_person")
  phone         String
  email         String
  address       String
  createdAt     DateTime  @default(now()) @map("created_at")
  user          Profile   @relation(fields: [userId], references: [id])
  invoices      Invoice[]
  jobs          Job[]
  quotes        Quote[]

  @@map("clients")
}

model Job {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  clientId      String   @map("client_id")
  quoteId       String?  @map("quote_id")
  invoiceId     String?  @map("invoice_id")
  date          DateTime
  eventName     String   @map("event_name")
  medics        Int
  hours         Float
  startTime     String?  @map("start_time")
  endTime       String?  @map("end_time")
  hourlyRate    Float    @map("hourly_rate")
  totalCost     Float    @map("total_cost")
  createdAt     DateTime @default(now()) @map("created_at")
  isComplete    Boolean  @default(false) @map("is_complete")
  selectedItems Json?    @map("selected_items")
  client        Client   @relation(fields: [clientId], references: [id])
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  quote         Quote?   @relation(fields: [quoteId], references: [id])
  user          Profile  @relation(fields: [userId], references: [id])

  @@map("jobs")
}

model Quote {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  clientId    String   @map("client_id")
  quoteNumber    String   @map("quote_number")
  totalAmount    Float    @map("total_amount")
  discount       Float?   @default(0)
  discountAmount Float?   @default(0) @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")
  jobs        Job[]
  client      Client   @relation(fields: [clientId], references: [id])
  user        Profile  @relation(fields: [userId], references: [id])

  @@map("quotes")
}

model Invoice {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  clientId      String   @map("client_id")
  invoiceNumber  String   @map("invoice_number")
  totalAmount    Float    @map("total_amount")
  discount       Float?   @default(0)
  discountAmount Float?   @default(0) @map("discount_amount")
  status         String
  createdAt     DateTime @default(now()) @map("created_at")
  client        Client   @relation(fields: [clientId], references: [id])
  user          Profile  @relation(fields: [userId], references: [id])
  jobs          Job[]

  @@map("invoices")
}

model ServiceRate {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  value     Float
  createdAt DateTime @default(now()) @map("created_at")
  user      Profile  @relation(fields: [userId], references: [id])

  @@map("service_rates")
}
